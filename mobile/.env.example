# LAN IP машины с запущенным server/ (не 127.0.0.1 с телефона)
EXPO_PUBLIC_API_URL=http://192.168.1.10:4444

# Web SPA для staff-разделов (G.1) — dev: Vite client; prod: https://izibuy.ru
# EXPO_PUBLIC_WEB_APP_URL=http://127.0.0.1:5173
# EXPO_PUBLIC_WEB_APP_URL=https://izibuy.ru

# Prod / staging (фаза 5)
# EXPO_PUBLIC_API_URL=https://api.izibuy.ru
# EXPO_PUBLIC_UPLOAD_BASE_URL=https://cdn.izibuy.ru

# Sentry (фаза 6, опционально — без DSN интеграция не активна)
# EXPO_PUBLIC_SENTRY_DSN=https://zzz@oZZZ.ingest.sentry.io/ZZZ

# Яндекс.Карты (точка самовывоза на карте; адрес из подсказок работает и без ключа)
# EXPO_PUBLIC_YANDEX_MAPS_API_KEY=
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# EXPO_PUBLIC_GIT_COMMIT_SHA=abc1234
# EXPO_PUBLIC_APP_ENV=development

# Публичный URL политики (для сторов и кнопки «Открыть на сайте»)
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://izibuy.ru/privacy.html
