{
  "expo": {
    "name": "Gitorg",
    "slug": "gitorg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gitorg",
    "userInterfaceStyle": "automatic",
    "linking": {
      "prefixes": [
        "gitorg://",
        "https://gitorg.ru",
        "https://www.gitorg.ru"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.gitorg.app",
      "associatedDomains": ["applinks:gitorg.ru", "applinks:www.gitorg.ru"],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ru.gitorg.app",
      "screenOrientation": "portrait",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "gitorg.ru", "pathPrefix": "/" },
            { "scheme": "https", "host": "www.gitorg.ru", "pathPrefix": "/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#d76344",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0c0e12"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gitorg нужен доступ к галерее, чтобы вы могли прикрепить фото и видео к объявлению и загрузить фото профиля",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F25623"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7eab96e6-18b8-4058-a381-c5c35c25d986"
      }
    }
  }
}
