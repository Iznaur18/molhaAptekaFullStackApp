# Шаблон production — скопируй на VPS как server/.env (chmod 600)
# Проверка: npm run preflight:prod

NODE_ENV=production
PORT=4444

JWT_SECRET=REPLACE_WITH_crypto_randomBytes_32_hex
JWT_ACCESS_SECRET=REPLACE_WITH_crypto_randomBytes_32_hex
JWT_REFRESH_SECRET=REPLACE_WITH_different_crypto_randomBytes_32_hex
# Atlas с auth. Запрещено: mongodb://127.0.0.1 (корневой docker-compose — только local/dev).
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/izibuy?retryWrites=true&w=majority

# AES-256-GCM для паспортных ПДн в Mongo (обязательно). 64 hex.
PASSPORT_VAULT_KEK=REPLACE_WITH_crypto_randomBytes_32_hex
PASSPORT_VAULT_KEY_ID=v1
# BUYER_PASSPORT_SHARE_TTL_DAYS=90

FRONTEND_URL=https://izibuy.ru

# --- Медиа: вариант A (один домен, диск на VPS) ---
PUBLIC_UPLOAD_BASE_URL=https://izibuy.ru
# UPLOAD_STORAGE=disk

# --- Медиа: S3/R2 + CDN (см. docs/deploy/PROD-S3-CDN.md) ---
# UPLOAD_STORAGE=s3
# PUBLIC_UPLOAD_BASE_URL=https://cdn.izibuy.ru
# S3_BUCKET=izibuy-media
# ОБЯЗАТЕЛЬНО: отдельный НЕпубличный бакет для PII (селфи паспорта), НЕ за CDN.
# Должен отличаться от S3_BUCKET — иначе приватные файлы утекут по прямой CDN-ссылке.
# S3_PRIVATE_BUCKET=izibuy-media-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# S3_SERVER_SIDE_ENCRYPTION=AES256

# --- Опционально ---
# GIT_COMMIT_SHA=abc1234
# COOKIE_CROSS_SITE=true
# SMTP_HOST= SMTP_USER= SMTP_PASS= SMTP_FROM=
# SENTRY_DSN=
# Access-логи: unset → 0.1 в production; 0 = выкл
# ACCESS_LOG_SAMPLE_RATE=0.1
# DADATA_API_KEY= DADATA_SECRET_KEY=
# REDIS_URL=rediss://…
