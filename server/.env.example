# Скопируйте этот файл в .env и заполните значения.
# Команда: copy .env.example .env  (Windows) или  cp .env.example .env  (Linux/Mac)

# --- Обязательные ---

# Секрет для подписи JWT-токенов. Должен быть длинной случайной строкой.
# Пример генерации: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=iznaur2000

# Строка подключения к MongoDB (локально или Atlas).
# Локально: mongodb://localhost:27017/molhaApteka
# Atlas:    mongodb+srv://user:password@cluster.xxxxx.mongodb.net/dbname
MONGO_URI=mongodb://localhost:27017/molhaApteka

# --- Необязательные ---

# Порт сервера. По умолчанию 4444.
# PORT=4444

# URL фронтенда для CORS. Если не задан — разрешены запросы с любых доменов.
# Vite (этот репозиторий, client): http://127.0.0.1:5173 — совпадает с host в vite.config.js
# FRONTEND_URL=http://127.0.0.1:5173

# Режим (development / production). В production детали ошибок в ответах скрываются.
# NODE_ENV=development
