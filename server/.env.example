# Скопируйте этот файл в .env и заполните значения.
# Команда: copy .env.example .env  (Windows) или  cp .env.example .env  (Linux/Mac)

# --- Обязательные ---

# Секрет для подписи JWT-токенов. Должен быть длинной случайной строкой.
# Пример генерации: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_crypto_randomBytes_32_hex
# Prod: отдельные секреты access/refresh (assertProductionEnv hard-fail без них).
# JWT_ACCESS_SECRET=REPLACE_WITH_crypto_randomBytes_32_hex
# JWT_REFRESH_SECRET=REPLACE_WITH_different_crypto_randomBytes_32_hex

# Строка подключения к MongoDB (локально или Atlas).
# Локально (Docker: npm run mongo:up в корне репо) — без auth, только localhost:
#   mongodb://127.0.0.1:27017/molhaApteka?replicaSet=rs0
# Не поднимай корневой docker-compose.yml на VPS / в production.
# Production (Atlas с auth): mongodb+srv://user:password@cluster.xxxxx.mongodb.net/dbname
# Важно: для транзакций заказов/баллов нужен replica set (Atlas M0+ или rs0)
MONGO_URI=mongodb://127.0.0.1:27017/molhaApteka?replicaSet=rs0

# Read replica для листинга каталога GET /product (опционально).
# Atlas: connection string с readPreference=secondary или secondaryPreferred.
# Без переменной — каталог читает с primary (dev / один инстанс).
# MONGO_URI_READ=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/dbname?readPreference=secondaryPreferred

# --- Atlas Search (опционально, prod каталог GET /product?search=) ---
# Требует Search Index product_catalog в Atlas (см. server/docs/ATLAS-SEARCH.md).
# Без флага или на локальном mongod — regex fallback.
# ATLAS_SEARCH_ENABLED=true

# --- Rate limit (опционально) ---
# Общий лимит только на API; /uploads и /health не считаются.
# Dev по умолчанию 200_000 / 15 мин; production — 50_000 / 15 мин.
# RATE_LIMIT_MAX_REQUESTS=50000
# RATE_LIMIT_WINDOW_MS=900000

# --- Redis (опционально, 2+ API инстанса) ---
# Общий store для express-rate-limit + BullMQ (email verify, cron).
# Без REDIS_URL — in-memory rate limit + sync email + setInterval cron на API.
# Dev: redis://127.0.0.1:6379
# Prod: rediss://… (TLS), иначе preflight предупредит.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_RATE_LIMIT_PREFIX=izibuy:rl:
# REDIS_BULLMQ_PREFIX=izibuy:mq:

# --- Passport vault (AES-256-GCM at rest) ---
# Обязателен в production. 32 байта = 64 hex.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PASSPORT_VAULT_KEK=
# PASSPORT_VAULT_KEY_ID=v1
# TTL snapshot паспорта на заказе рассрочки (дней после consent), default 90:
# BUYER_PASSPORT_SHARE_TTL_DAYS=90

# --- Cron leader (2+ API или отдельный worker) ---
# Dev: unset — cron на API (один процесс).
# Prod API replica: CRON_LEADER=false
# Prod leader: CRON_LEADER=true на одном API или `npm run start:worker` (worker.js)
# CRON_LEADER=true

# --- Health / deploy (опционально) ---
# GIT_COMMIT_SHA=abc1234
# В CI можно пробросить GITHUB_SHA; иначе /health попробует git rev-parse в dev.

# --- Sentry (опционально, 5xx + необработанные) ---
# SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Access-логи (JSON event=http.access) ---
# unset: production=0.1, development=1, test=0
# ACCESS_LOG_SAMPLE_RATE=0.1
# ACCESS_LOG_SAMPLE_RATE=0
# Логи в терминале: development → pretty; prod → json. Принудительно:
# LOG_FORMAT=pretty
# LOG_FORMAT=json

# --- Production (обязательно при NODE_ENV=production) ---

# NODE_ENV=production
# FRONTEND_URL=https://izibuy.ru
# PORT=4444

# Медиа на диске VPS (вариант A, один домен):
# PUBLIC_UPLOAD_BASE_URL=https://izibuy.ru

# Медиа S3/R2 + CDN (рекомендуется для prod):
# UPLOAD_STORAGE=s3
# PUBLIC_UPLOAD_BASE_URL=https://cdn.izibuy.ru
# S3_BUCKET=izibuy-media
# Отдельный НЕпубличный бакет для PII (селфи паспорта), НЕ за CDN. Обязателен в prod,
# должен отличаться от S3_BUCKET (иначе приватные файлы утекут по прямой CDN-ссылке).
# S3_PRIVATE_BUCKET=izibuy-media-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# AWS S3: AES256 или aws:kms (+ S3_SSE_KMS_KEY_ID). R2 — at rest по умолчанию, можно не задавать.
# S3_SERVER_SIDE_ENCRYPTION=AES256
# S3_SSE_KMS_KEY_ID=
# Чеклист: docs/deploy/PROD-S3-CDN.md

# Если фронт и API на разных доменах в production (VITE_API_URL ≠ origin):
# COOKIE_CROSS_SITE=true
# Только при NODE_ENV=production: SameSite=None; Secure (нужен HTTPS).
# В dev не включайте — cookie не сохранятся по http://.

# --- Dev ---

# URL фронтенда для CORS (обязателен в NODE_ENV=production).
# Vite (этот репозиторий, client): http://127.0.0.1:5173 — совпадает с host в vite.config.js
FRONTEND_URL=http://127.0.0.1:5173

# Публичный базовый URL для ссылок на загруженные файлы (без слэша в конце).
# Production disk: https://izibuy.ru
# Production S3/CDN: https://cdn.izibuy.ru (custom domain бакета R2/S3)
# Dev: можно не задавать — относительный /uploads/... (Vite proxy).
# PUBLIC_UPLOAD_BASE_URL=https://izibuy.ru

# --- Object storage (опционально, production) ---
# UPLOAD_STORAGE=disk   — по умолчанию, папка server/uploads
# UPLOAD_STORAGE=s3     — AWS S3, Cloudflare R2, MinIO
# S3_BUCKET=izibuy-media
# S3_PRIVATE_BUCKET=izibuy-media-private   — отдельный непубличный бакет для PII, обязателен в prod
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# При UPLOAD_STORAGE=s3 обязателен PUBLIC_UPLOAD_BASE_URL (CDN origin бакета).

# --- SMTP (email verify, опционально) ---
# Пока не настроен nodemailer — ссылка verify в логах [email-verify]
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# --- SMSPILOT (SMS / phone verify, опционально) ---
# Ключ: Личный кабинет → Настройки → API https://smspilot.ru/my-settings.php#api
# SMSPILOT_API_KEY=

# --- DaData (подсказки и проверка адресов РФ, доставка до квартиры) ---
# https://dadata.ru/profile/#info
# DADATA_API_KEY=
# DADATA_SECRET_KEY=

# --- 1С интеграция (per-seller HTTP JSON) ---
# Шифрование API-ключей продавцов (64 hex = 32 байта). Если пусто — derive из JWT_SECRET.
# ONEC_CREDENTIALS_KEK=
# Интервал cron (мс), минимум 60000. По умолчанию 5 минут.
# ONEC_SYNC_INTERVAL_MS=300000
# Таймаут HTTP к 1С (мс).
# ONEC_HTTP_TIMEOUT_MS=30000
# Локальный mock: npm run onec:mock → http://127.0.0.1:3091 ключ mock-onec-key
# ONEC_MOCK_PORT=3091
# ONEC_MOCK_API_KEY=mock-onec-key

# --- Expo push (mobile remote notifications, опционально) ---
# Для production throughput: https://expo.dev/accounts/[account]/settings/access-tokens
# EXPO_ACCESS_TOKEN=

# cd server && npm run create-admin -- admin@molha.ru YourPassword123 [userName]
# Опция: --reset-password — сменить пароль, если email уже зарегистрирован

# Проверка env перед деплоем:
# cd server && npm run validate:prod
