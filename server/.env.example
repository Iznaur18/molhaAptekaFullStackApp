# Скопируйте этот файл в .env и заполните значения.
# Команда: copy .env.example .env  (Windows) или  cp .env.example .env  (Linux/Mac)

# --- Обязательные ---

# Секрет для подписи JWT-токенов. Должен быть длинной случайной строкой.
# Пример генерации: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=iznaur2000

# Строка подключения к MongoDB (локально или Atlas).
# Локально: mongodb://localhost:27017/molhaApteka
# Atlas:    mongodb+srv://user:password@cluster.xxxxx.mongodb.net/dbname
MONGO_URI=mongodb://localhost:27017/molhaApteka

# --- Необязательные ---

# Порт сервера. По умолчанию 4444.
# PORT=4444

# URL фронтенда для CORS. Если не задан — разрешены запросы с любых доменов.
# Vite (этот репозиторий, client): http://127.0.0.1:5173 — совпадает с host в vite.config.js
# FRONTEND_URL=http://127.0.0.1:5173

# Режим (development / production). В production детали ошибок в ответах скрываются.
# NODE_ENV=development

# --- DaData (подсказки и проверка адресов РФ, доставка до квартиры) ---
# https://dadata.ru/profile/#info
# DADATA_API_KEY=
# DADATA_SECRET_KEY=

# --- Первый администратор (CLI, не через сайт) ---
# cd server && npm run create-admin -- admin@molha.ru YourPassword123 [userName]
# Опция: --reset-password — сменить пароль, если email уже зарегистрирован

# Как пользоваться админкой на сайте

# cd server
# npm run create-admin -- твой@email.com ТвойПароль123
# С никнеймом:

# npm run create-admin -- admin@molha.ru MyPassword123 adminboss
# Если email уже зарегистрирован — роль станет admin, пароль не меняется.

# Сменить пароль существующему:

# npm run create-admin -- admin@molha.ru НовыйПароль123 --reset-password
# Дальше
# npm run start:dev (сервер)
# Сайт → Войти → тот же email и пароль
# Мой профиль → вкладка «Все заказы»
# Нужны MONGO_URI в server/.env и запущенная MongoDB. Подсказка есть в server/.env.example.