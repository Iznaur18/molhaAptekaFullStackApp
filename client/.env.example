# Скопируй в .env при необходимости (Windows: copy .env.example .env)

# Сборка production: полный URL бэкенда без слэша в конце.
# В dev обычно не нужен — Vite проксирует на 127.0.0.1:4444 (см. vite.config.js).
# VITE_API_URL=http://127.0.0.1:4444

# Feature flags (пусто = дефолт из featureFlags.js)
# VITE_FF_CATALOG_BROWSER_SUBCATEGORY_FILTER=true
# Tree picker категорий при создании товара всегда включён (legacy flat list удалён).
# VITE_FF_REQUIRE_ADDRESS_FROM_DADATA_SUGGEST=false

# Sentry (только при production build, опционально)
# VITE_SENTRY_DSN=https://yyy@oYYY.ingest.sentry.io/YYY
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_GIT_COMMIT_SHA=abc1234

# Plausible (внешний traffic; без DOMAIN скрипт не грузится)
# VITE_PLAUSIBLE_DOMAIN=gitorg.ru
# VITE_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
# VITE_PLAUSIBLE_SHARED_URL=https://plausible.io/share/gitorg.ru?auth=...
