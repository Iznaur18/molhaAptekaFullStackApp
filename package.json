{
  "name": "molha-apteka",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "packages/*",
    "mobile"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:design-tokens": "node scripts/verify-design-tokens-parity.mjs",
    "verify:profile-sections": "npm run build --workspace=@izibuy/shared-lib && node scripts/verify-profile-sections-parity.mjs",
    "test:contract": "npm test --prefix contract",
    "test:shared-lib": "npm test --workspace=@izibuy/shared-lib",
    "test:installment-mobile": "node --test scripts/installment-partition.test.mjs scripts/installment-mobile-chrome.test.mjs",
    "test:packages": "npm run test:contract && npm run test:shared-lib",
    "test:server": "npm test --prefix server",
    "test:client": "npm test --prefix client",
    "test": "npm run test:server && npm run test:packages",
    "sync:legal": "node scripts/sync-legal-operator.mjs",
    "generate:intro-poster": "node scripts/generate-intro-poster.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "sharp": "^0.35.1"
  }
}
