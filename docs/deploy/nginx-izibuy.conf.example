# Izibuy — вариант A: один домен, SPA + API за nginx
#
# 1. Скопируй и отредактируй:
#    sudo cp docs/deploy/nginx-izibuy.conf.example /etc/nginx/sites-available/izibuy
# 2. Пути:
#    - root → каталог client/dist после npm run build
#    - upstream → Express на 127.0.0.1:4444
# 3. SSL (на VPS): docs/deploy/CERTBOT-SSL.md
#    ./docs/deploy/scripts/setup-ssl.sh admin@gitorg.ru
#    или: sudo certbot --nginx -d gitorg.ru -d www.gitorg.ru --redirect
#
# server/.env для этого варианта:
#   FRONTEND_URL=https://gitorg.ru
#   PUBLIC_UPLOAD_BASE_URL=https://gitorg.ru   # disk
#   UPLOAD_STORAGE=s3 + PUBLIC_UPLOAD_BASE_URL=https://cdn.gitorg.ru → см. PROD-S3-CDN.md
#   PORT=4444
#
# client: собирать БЕЗ VITE_API_URL (запросы на тот же origin)

upstream izibuy_api {
    server 127.0.0.1:4444;
    keepalive 32;
}

# Crawler’ы для Open Graph (WhatsApp/Telegram/VK/…) → API HTML, не SPA.
map $http_user_agent $is_og_bot {
    default 0;
    ~*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|vkShare|VKRobot|Pinterest|redditbot|Embedly|Quora\ Link\ Preview|Showyoubot|outbrain|Googlebot|bingbot|YandexBot|DuckDuckBot|Baiduspider|Applebot|SemrushBot|developers\.google\.com/\+/web/snippet) 1;
}

# Редирект HTTP → HTTPS (раскомментируй после certbot или настрой вручную)
# server {
#     listen 80;
#     listen [::]:80;
#     server_name gitorg.ru www.gitorg.ru;
#     return 301 https://gitorg.ru$request_uri;
# }

server {
    listen 80;
    listen [::]:80;
    server_name gitorg.ru www.gitorg.ru;

    # Certbot (HTTP-01) — не удаляй до получения сертификата
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        allow all;
    }

    # После `certbot --nginx` появится отдельный server на 443 + редирект с :80

    root /var/www/izibuy/client/dist;
    index index.html;

    # Фото 5 МБ, видео розыгрыша 5 МБ + запас
    client_max_body_size 52m;

    # --- Раздача загрузок через Express (или alias на server/uploads, см. ниже) ---

    # Приватные медиа (селфи паспорта) наружу не отдаются НИКОГДА — только
    # `GET /upload/private/:filename` с проверкой прав. Второй эшелон к гварду
    # в server/createApp.js: nginx нормализует URI до сравнения, поэтому здесь
    # ловятся и `//private/`, и обычный `/private/`.
    location ~* ^/uploads/+private/ {
        return 404;
    }

    location /uploads/ {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        # Загруженный файл нельзя MIME-sniff'ить в HTML/JS (защита от stored-XSS).
        add_header X-Content-Type-Options "nosniff" always;
    }

    # POST /upload и POST /upload/video (поле image / video)
    location /upload {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }

    # --- API (как в client/vite.config.js DEV_API_PROXY_PREFIXES) ---

    location /health {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    location /auth/ {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /cart/ {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA document: /user/:mongoId (тот же URL, что GET /user/:id API —
    # XHR с Accept: application/json уходит в API; text/html → index.html)
    location ~ "^/user/[a-f\d]{24}$" {
        if ($http_accept ~* ^text/html) {
            rewrite ^ /index.html last;
        }
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Только /user и /user/... — НЕ /user-list (SPA, см. homeMainViewPaths.js)
    location ~ ^/user(/|$) {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /vote/ {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /order {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Множественное число намеренно: SPA-роуты /become-courier и
    # /courier-moderation не должны попадать в API по префиксу.
    location /couriers {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA document: /product/:mongoId — люди → index.html; crawler → API (OG).
    location ~ "^/product/[a-fA-F\d]{24}$" {
        error_page 418 = @gitorg_api_proxy;
        error_page 419 = @product_spa;

        if ($is_og_bot = 1) {
            return 418;
        }
        if ($http_accept ~* ^text/html) {
            return 419;
        }
        return 418;
    }

    location @product_spa {
        rewrite ^ /index.html last;
    }

    location @gitorg_api_proxy {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # POST /product (создание) — без trailing slash, иначе SPA index.html
    location /product {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Витрина /seller/:id — crawler → API (OG); люди → SPA.
    location ~ "^/seller/[a-fA-F\d]{24}$" {
        error_page 418 = @gitorg_api_proxy;
        if ($is_og_bot = 1) {
            return 418;
        }
        rewrite ^ /index.html last;
    }

    location /address/ {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /app-intro {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /intro-ad {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Остальные API-префиксы (sync: client/src/shared/lib/devApiProxy.js + server/createApp.js).
    # Без них nginx отдаёт SPA index.html → UI «Неверный ответ сервера».
    location /installment {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /favorites {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /price-offers {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /users-loyalty-raffle {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /site-header-banner-campaign {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /site-header-banner {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /seller-personal-category {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /seller-shelf {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /staff {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /audit {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # POST /analytics/track-ad (показы/клики баннеров) + админские отчёты.
    # Без этого блока nginx отдаёт статику и POST падает с 405 Method Not Allowed.
    location /analytics {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /onec {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Статика Vite (immutable hash) ---

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # Sourcemaps не отдаём с прода
    location ~* \.map$ {
        return 404;
    }

    # intro и прочие файлы из public/
    location /intro/ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # --- SPA (React Router) ---
    # CSP: cd server && node scripts/printSpaCspHeader.js  (из production .env)
    # Скрипт читает client/.env* (VITE_PLAUSIBLE_*) и считает 'sha256-…' инлайн-скрипта
    # из client/dist/index.html — после правки client/index.html перегенерируй заголовок.
    # См. server/docs/CSP-HELMET.md — для S3 подставится https://cdn.gitorg.ru в img-src/media-src

    location / {
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-XTXJQvmpZzPx4C1a9cJbXI7HH/DvsaJqqxo+7aILbqc=' https://plausible.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: https://cdn.gitorg.ru; media-src 'self' blob: https: https://cdn.gitorg.ru; font-src 'self' data:; connect-src 'self' https://*.ingest.sentry.io https://plausible.io; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests;" always;
        # Доп. security-заголовки (defense-in-depth к CSP).
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=()" always;
        # HSTS — только по HTTPS (браузер игнорирует по HTTP). Если certbot уже
        # добавляет Strict-Transport-Security — удали эту строку, чтобы не дублировать.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 256;
}

# --- Опционально: отдавать /uploads напрямую с диска (быстрее, без Node) ---
# Замени блок location /uploads/ выше на код ниже. Блок `location ~* ^/uploads/+private/`
# при этом ОБЯЗАТЕЛЕН и должен остаться: с alias'ом Express уже не участвует,
# и его гвард приватных файлов не отработает.
#
# location ~* ^/uploads/+private/ {
#     return 404;
# }
#
# location /uploads/ {
#     alias /var/www/izibuy/server/uploads/;
#     expires 7d;
#     add_header Cache-Control "public, max-age=604800";
#     add_header Cross-Origin-Resource-Policy cross-origin;
#     add_header X-Content-Type-Options "nosniff" always;
# }
