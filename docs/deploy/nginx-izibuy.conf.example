# Izibuy — вариант A: один домен, SPA + API за nginx
#
# 1. Скопируй и отредактируй:
#    sudo cp docs/deploy/nginx-izibuy.conf.example /etc/nginx/sites-available/izibuy
# 2. Пути:
#    - root → каталог client/dist после npm run build
#    - upstream → Express на 127.0.0.1:4444
# 3. SSL (на VPS): docs/deploy/CERTBOT-SSL.md
#    ./docs/deploy/scripts/setup-ssl.sh admin@gitorg.ru
#    или: sudo certbot --nginx -d gitorg.ru -d www.gitorg.ru --redirect
#
# server/.env для этого варианта:
#   FRONTEND_URL=https://gitorg.ru
#   PUBLIC_UPLOAD_BASE_URL=https://gitorg.ru   # disk
#   UPLOAD_STORAGE=s3 + PUBLIC_UPLOAD_BASE_URL=https://cdn.gitorg.ru → см. PROD-S3-CDN.md
#   PORT=4444
#
# client: собирать БЕЗ VITE_API_URL (запросы на тот же origin)

upstream izibuy_api {
    server 127.0.0.1:4444;
    keepalive 32;
}

# Редирект HTTP → HTTPS (раскомментируй после certbot или настрой вручную)
# server {
#     listen 80;
#     listen [::]:80;
#     server_name gitorg.ru www.gitorg.ru;
#     return 301 https://gitorg.ru$request_uri;
# }

server {
    listen 80;
    listen [::]:80;
    server_name gitorg.ru www.gitorg.ru;

    # Certbot (HTTP-01) — не удаляй до получения сертификата
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        allow all;
    }

    # После `certbot --nginx` появится отдельный server на 443 + редирект с :80

    root /var/www/izibuy/client/dist;
    index index.html;

    # Фото 5 МБ, видео розыгрыша 5 МБ + запас
    client_max_body_size 52m;

    # --- Раздача загрузок через Express (или alias на server/uploads, см. ниже) ---

    location /uploads/ {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        # Загруженный файл нельзя MIME-sniff'ить в HTML/JS (защита от stored-XSS).
        add_header X-Content-Type-Options "nosniff" always;
    }

    # POST /upload и POST /upload/video (поле image / video)
    location /upload {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }

    # --- API (как в client/vite.config.js DEV_API_PROXY_PREFIXES) ---

    location /health {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    location /auth/ {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /cart/ {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA document: /user/:mongoId (тот же URL, что GET /user/:id API —
    # XHR с Accept: application/json уходит в API; text/html → index.html)
    location ~ "^/user/[a-f\d]{24}$" {
        if ($http_accept ~* ^text/html) {
            rewrite ^ /index.html last;
        }
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Только /user и /user/... — НЕ /user-list (SPA, см. homeMainViewPaths.js)
    location ~ ^/user(/|$) {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /vote/ {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /order {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA document: /product/:mongoId (тот же URL, что GET/PATCH /product/:id API —
    # XHR с Accept: application/json уходит в API; text/html → index.html)
    location ~ "^/product/[a-f\d]{24}$" {
        if ($http_accept ~* ^text/html) {
            rewrite ^ /index.html last;
        }
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # POST /product (создание) — без trailing slash, иначе SPA index.html
    location /product {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /address/ {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /app-intro {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /intro-ad {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Остальные API-префиксы (sync: client/src/shared/lib/devApiProxy.js + server/createApp.js).
    # Без них nginx отдаёт SPA index.html → UI «Неверный ответ сервера».
    location /installment {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /favorites {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /price-offers {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /users-loyalty-raffle {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /site-header-banner-campaign {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /site-header-banner {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /seller-personal-category {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /audit {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /onec {
        proxy_pass http://izibuy_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Статика Vite (immutable hash) ---

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # Sourcemaps не отдаём с прода
    location ~* \.map$ {
        return 404;
    }

    # intro и прочие файлы из public/
    location /intro/ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # --- SPA (React Router) ---
    # CSP: cd server && node scripts/printSpaCspHeader.js  (из production .env)
    # См. server/docs/CSP-HELMET.md — для S3 подставится https://cdn.gitorg.ru в img-src/media-src

    location / {
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: https://cdn.gitorg.ru; media-src 'self' blob: https: https://cdn.gitorg.ru; font-src 'self' data:; connect-src 'self' https://*.ingest.sentry.io; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests;" always;
        # Доп. security-заголовки (defense-in-depth к CSP).
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=()" always;
        # HSTS — только по HTTPS (браузер игнорирует по HTTP). Если certbot уже
        # добавляет Strict-Transport-Security — удали эту строку, чтобы не дублировать.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 256;
}

# --- Опционально: отдавать /uploads напрямую с диска (быстрее, без Node) ---
# Замени блок location /uploads/ выше на:
#
# location /uploads/ {
#     alias /var/www/izibuy/server/uploads/;
#     expires 7d;
#     add_header Cache-Control "public, max-age=604800";
#     add_header Cross-Origin-Resource-Policy cross-origin;
#     add_header X-Content-Type-Options "nosniff" always;
# }
