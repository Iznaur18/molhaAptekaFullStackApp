# Зависимости
node_modules/

# Секреты и окружение (примеры остаются в репозитории)
.env
.env.*
!.env.example
!.env.production.example

# Сборка и вывод
dist/
build/
client/dist/
*.tsbuildinfo

# Тесты и покрытие
coverage/
playwright-report/
test-results/
.nyc_output/

# Пользовательские данные и медиа (в т.ч. ПДн)
server/uploads/

# Логи
*.log
npm-debug.log*
logs/

# Expo (генерируемые артефакты)
.expo*/
mobile/.expo*/
web-build/

# Временные файлы
tmp/
*.tmp
tmp-*.txt

# ОС и редакторы
.DS_Store
Thumbs.db
*.swp
.idea/

# Документация не версионируется: в docs/ копятся черновики и отчёты,
# которые шумят в `git status`. Уже отслеживаемых 73 файлов это НЕ касается —
# git игнорирует .gitignore для того, что уже в индексе. Но учти обратную
# сторону: новый документ здесь придётся добавлять через `git add -f`.
docs/
AGENTS.md
