{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend (Express + nodemon)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:dev"
      ],
      "cwd": "server",
      "port": 4444,
      "autoPort": false
    },
    {
      "name": "Client (Vite dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "client",
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "Mobile (Expo)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:dev"
      ],
      "cwd": "mobile",
      "port": 8081
    },
    {
      "name": "Mobile (Expo Web)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--go",
        "--port",
        "8082"
      ],
      "cwd": "mobile",
      "port": 8082,
      "autoPort": false
    },
    {
      "name": "Client (Vite preview)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "cwd": "client",
      "port": 4173,
      "autoPort": false
    },
    {
      "name": "Mobile (Expo Go)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:go"
      ],
      "cwd": "mobile",
      "port": 8081,
      "autoPort": false
    }
  ]
}
